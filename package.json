{
  "name": "myduo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:core": "tsx scripts/check-core.ts && tsx src/lib/server/recall.check.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm check:core",
    "setup:local": "node scripts/configure-local.mjs",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "neo4j-driver": "6.2.0",
    "next": "16.3.5",
    "openai": "7.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
