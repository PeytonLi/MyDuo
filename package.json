{
  "name": "myduo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --conditions=react-server --test --test-concurrency=1 tests/core.test.ts",
    "test:integration": "node --env-file=.env.local --conditions=react-server --import tsx --test --test-concurrency=1 tests/database.test.ts tests/reviews.test.ts",
    "test:regression": "pnpm test:unit && pnpm test:integration",
    "test:e2e": "node --env-file=.env.local ./node_modules/@playwright/test/cli.js test",
    "test:providers": "node --env-file=.env.local --conditions=react-server --import tsx --test --test-concurrency=1 tests/providers.test.ts",
    "test:evaluation": "tsx scripts/evaluate.ts",
    "check:all": "pnpm check && pnpm build && pnpm test:e2e",
    "check:core": "pnpm test:unit",
    "check": "pnpm typecheck && pnpm lint && pnpm test:evaluation && pnpm test:regression",
    "setup:local": "node scripts/configure-local.mjs",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@googleworkspace/meet-addons": "1.2.0",
    "neo4j-driver": "6.2.0",
    "next": "16.3.5",
    "openai": "7.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
